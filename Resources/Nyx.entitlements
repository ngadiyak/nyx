<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime is required for notarisation. Everything below is an exception to it,
         and each one is here because the terminal cannot work without it. -->

    <!-- A terminal's whole job is to run other programs. Without this the hardened runtime refuses
         to let a child process inherit the environment we hand it, and the shell does not start. -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The shell and everything it runs are the user's own programs; they inherit our sandbox
         status, and a sandboxed terminal cannot open the files the user asks it to. -->
    <key>com.apple.security.inherit</key>
    <false/>

    <!-- `⌘-click` on a path opens it, and the scrollback can be saved anywhere the user chooses. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
